# Copy to .env (git-ignored) and fill in. Read by the app (src/plumbing/elasticConfig.mjs, src/plumbing/clock.mjs)
# and by the data tooling (elasticsearch/setup.py, elasticsearch/cinder/*.py).
ES_URL=https://<your-project>.es.<region>.gcp.elastic.cloud:443
ES_API_KEY=<base64 API key>
ES_INDEX=eventapp

# Demo configuration (not secret): the event the demo runs against, and the time the demo clock starts at.
# DevSummit 2026, Salt Palace Convention Center, Salt Lake City (America/Denver); 30 minutes before day-1 lunch.
CINDER_DEMO_EVENT_ID=urn:ue:event:devsummit-2026
CINDER_DEMO_TIME=2026-12-23T11:45:00-07:00
# true = the demo time does not advance
CINDER_DEMO_FROZEN=false
