{
  "name": "cinder-conference",
  "version": "1.0.0",
  "description": "CINDER \u2014 The Social Infrastructure for Conferences. Intelligent, agent-facilitated social coordination platform.",
  "type": "module",
  "main": "src/core/CinderApp.mjs",
  "scripts": {
    "start": "node bin/start-with-ui.mjs",
    "start:api": "node bin/server.mjs",
    "dev:ui": "vite --config src/ui/web/react/vite.config.ts",
    "build:ui": "tsc -p src/ui/web/react/tsconfig.json --noEmit && vite build --config src/ui/web/react/vite.config.ts",
    "preview:ui": "vite preview --config src/ui/web/react/vite.config.ts",
    "test:ui": "node --test tests/react-ui.browser.mjs",
    "demo": "node bin/demo.mjs",
    "demo:journey": "node bin/record-live-journey.mjs",
    "deck": "python3 scripts/generate_cinder_90s_deck.py",
    "test": "node --test tests/*.test.mjs",
    "test:live": "node --env-file=.env --test tests/elasticsearch-live.test.mjs",
    "check": "npx -y -p github:CardSorting/HEAV3NS-JOY#7112dca56704a3bff5f27b9ce8d22cf93d15ead9 joy-check .",
    "docs:check": "node bin/docs-check.mjs .",
    "verify": "npm test && npm run check && npm run docs:check"
  },
  "keywords": [
    "cinder",
    "elasticsearch",
    "conference",
    "networking",
    "ai-agent",
    "vector-search",
    "hybrid-retrieval",
    "pods"
  ],
  "author": "Cinder Team",
  "license": "MIT",
  "dependencies": {
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "puppeteer-core": "^25.16.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.8"
  }
}
